#compdef lumina
# Zsh completion for lumina
# Install: copy to a directory in $fpath (e.g. /usr/local/share/zsh/site-functions/_lumina)

_lumina() {
    local line state

    _arguments -C \
        '1: :_lumina_cmds' \
        '*:: :->cmd_args'

    case $state in
        cmd_args)
            case $line[1] in
                system)    _lumina_system   ;;
                stack)     _lumina_stack    ;;
                dev)       _lumina_dev      ;;
                apps)      _lumina_apps     ;;
                gnome)     _lumina_gnome    ;;
                ai)        _lumina_ai       ;;
                db)        _lumina_db       ;;
                repo)      _lumina_repo     ;;
                set)       _lumina_set      ;;
            esac
            ;;
    esac
}

_lumina_cmds() {
    local -a cmds
    cmds=(
        'system:Gerenciamento Linux (pós-install, fontes, apps, update)'
        'stack:DevStack Docker (config, lifecycle, banco)'
        'dev:Ferramentas de desenvolvimento (LLMs, IDEs, terminais, MCP)'
        'apps:Aplicativos Flatpak (instalar, desinstalar, webapps)'
        'gnome:Personalização GNOME (temas, ícones, cursor, extensões)'
        'ai:Contextos AI (gerar, limpar)'
        'db:Operações MariaDB (backup, restore, otimizar)'
        'repo:Repositórios Git (global, init, clone, ident, gitignore, conduct)'
        'set:Configurar Lumina (workspace, docker, theme, flatpak)'
        'self-update:Verificar e instalar atualizações'
        'self-uninstall:Remover o binário e as configurações'
        'self-config:Configurar Lumina interativamente'
        'version:Exibir a versão instalada'
        'help:Exibir referência de comandos'
    )
    _describe 'comando' cmds
}

# ── system ────────────────────────────────────────────────────────────────────

_lumina_system() {
    local line state

    _arguments -C \
        '1: :_lumina_system_cmds' \
        '*:: :->args'

    case $state in
        args)
            case $line[1] in
                pos)  _values 'distro' 'mint' 'zorin' 'ubuntu' 'fedora' ;;
                apps) _values 'ação' 'install' 'uninstall' 'webapps' ;;
            esac
            ;;
    esac
}

_lumina_system_cmds() {
    local -a cmds
    cmds=(
        'pos:Pós-instalação (mint, zorin, ubuntu, fedora)'
        'fonts:Gerenciar fontes'
        'templates:Templates de arquivos em ~/Templates'
        'apps:Instalar/desinstalar aplicativos Flatpak'
        'gnome:Personalização GNOME'
        'update:Atualizar sistema completo'
        'ulauncher:Instalar Ulauncher e temas'
        'toys:Instalar Linux Toys'
        'megasync:Instalar MegaSync'
    )
    _describe 'subcomando' cmds
}

# ── stack ─────────────────────────────────────────────────────────────────────

_lumina_stack() {
    local line state

    _arguments -C \
        '1: :_lumina_stack_cmds' \
        '*:: :->args'

    case $state in
        args)
            case $line[1] in
                config) _values 'etapa' 'docker' 'workspace' 'stack' ;;
            esac
            ;;
    esac
}

_lumina_stack_cmds() {
    local -a cmds
    cmds=(
        'config:Configurar stack (docker, workspace, stack)'
        'start:Iniciar stack de containers'
        'end:Finalizar stack de containers'
        'restart:Reiniciar stack de containers'
        'log:Visualizar logs em tempo real'
        'status:Status e uso de recursos'
        'db:Exibir dados de conexão do banco'
        'fix-perm:Corrigir permissões do workspace'
    )
    _describe 'subcomando' cmds
}

